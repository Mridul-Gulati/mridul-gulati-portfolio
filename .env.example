# Copy to .env.local for local dev, and add the same keys in Vercel > Settings > Environment Variables.
# Never commit .env.local.

# Public, safe in the browser (Supabase > Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Server-only. Never prefix these with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
RESEND_API_KEY=
# Until you verify a domain in Resend, leave RESEND_FROM_EMAIL empty (uses onboarding@resend.dev),
# and OWNER_EMAIL must be the email you signed up to Resend with.
RESEND_FROM_EMAIL=
OWNER_EMAIL=
# Any long random string, e.g. `openssl rand -hex 32`. Salts the hashed visitor IDs.
VISITOR_HASH_SALT=
# Signs the admin two-step login cookies (min 32 chars). `openssl rand -hex 32`.
# Changing it signs out every admin session.
ADMIN_SESSION_SECRET=
# Any long random string, e.g. `openssl rand -hex 32`. Vercel sends it to the cron route.
CRON_SECRET=
