# Copy to .env.local for local dev, and add the same keys in Vercel > Settings > Environment Variables.
# Never commit .env.local.

# Public, safe in the browser (Supabase > Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Server-only. Never prefix these with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
RESEND_API_KEY=
OWNER_EMAIL=
# Any long random string, e.g. `openssl rand -hex 32`. Vercel sends it to the cron route.
CRON_SECRET=
